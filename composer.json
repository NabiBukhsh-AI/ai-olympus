{
  "name": "pekral/ai-olympus",
  "description": "AI Olympus — a Composer plugin for PHP and Laravel projects that installs Claude Code and Codex rules, agent skills, and custom agents",
  "license": "MIT",
  "type": "composer-plugin",
  "keywords": [
    "composer-plugin",
    "ai-olympus",
    "claude",
    "claude-code",
    "codex",
    "openai-codex",
    "ai-agents",
    "llm",
    "php-ai-olympus",
    "ai-olympus",
    "php",
    "laravel",
    "coding-standards",
    "rules",
    "phpstan",
    "pest",
    "clean-code"
  ],
  "authors": [
    {
      "name": "Petr Král",
      "email": "kral.petr.88@gmail.com",
      "homepage": "https://pekral.cz",
      "role": "lead"
    }
  ],
  "homepage": "https://pekral.cz",
  "support": {
    "issues": "https://github.com/pekral/ai-olympus/issues",
    "source": "https://github.com/pekral/ai-olympus",
    "docs": "https://github.com/pekral/ai-olympus#readme"
  },
  "require": {
    "php": "^8.3",
    "composer-plugin-api": "^2.0"
  },
  "require-dev": {
    "composer/composer": "^2.10.3",
    "ergebnis/composer-normalize": "^2.54.0",
    "laravel/pint": "^1.32.1",
    "pekral/phpcs-rules": "dev-master",
    "pekral/phpstan-rules": "dev-master",
    "pekral/rector-rules": "^0.5",
    "pestphp/pest": "^5.3.2",
    "pestphp/pest-plugin": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0.3",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.3.1",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan-phpunit": "^2.1.1",
    "rector/rector": ">=2.6.6 <2.6.7",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "autoload": {
    "psr-4": {
      "Pekral\\AiOlympus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/ai-olympus"
  ],
  "archive": {
    "exclude": [
      "/assets/ATTRIBUTION.md",
      "/assets/brands",
      "/assets/logo.png",
      "/assets/social-preview.png",
      "/assets/social-preview.svg",
      "/docs",
      "/tests"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "pekral/ai-olympus": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "class": "Pekral\\AiOlympus\\ComposerPlugin"
  },
  "scripts": {
    "analyse": [
      "echo \"🔍 Running PHPStan static analysis...\"",
      "vendor/bin/phpstan analyse --memory-limit=2G"
    ],
    "build": [
      "bin/ai-olympus install --force --prune",
      "@fix",
      "@check"
    ],
    "check": [
      "echo \"🚀 Running full quality check...\"",
      "@skill-check",
      "@composer-normalize-check",
      "@phpcs-check",
      "@pint-check",
      "@rector-check",
      "@analyse",
      "@security-audit",
      "@shell-self-tests",
      "@shellcheck",
      "@test:coverage"
    ],
    "composer-normalize-check": [
      "echo \"📝 Checking Composer normalize...\"",
      "composer normalize --dry-run"
    ],
    "composer-normalize-fix": [
      "echo \"📝 Running Composer normalize fix...\"",
      "composer normalize || true"
    ],
    "coverage": [
      "echo \"📊 Running code coverage analysis...\"",
      "php -d pcov.enabled=1 -d pcov.directory=src -d pcov.exclude=~tests~ -d xdebug.mode=off vendor/bin/pest --coverage tests --min=100"
    ],
    "fix": [
      "echo \"🔧 Running all fixes...\"",
      "@skill-check-fix",
      "@composer-normalize-fix",
      "@rector-fix",
      "@pint-fix",
      "@phpcs-fix",
      "echo \"✅ All fixes completed!\""
    ],
    "phpcs-check": [
      "echo \"✅ Running PHP CodeSniffer check...\"",
      "vendor/bin/phpcs --standard=ruleset.xml src/ tests/ bin/"
    ],
    "phpcs-fix": [
      "echo \"🔧 Running PHP CodeSniffer fix...\"",
      "vendor/bin/phpcbf --standard=ruleset.xml src/ tests/ bin/ || true"
    ],
    "pint-check": [
      "echo \"🎨 Running Laravel Pint check...\"",
      "vendor/bin/pint src/ tests/ bin/ --test"
    ],
    "pint-fix": [
      "echo \"🎨 Running Laravel Pint fixes...\"",
      "vendor/bin/pint src/ tests/ bin/"
    ],
    "rector-check": [
      "echo \"🔄 Running Rector check (dry-run)...\"",
      "vendor/bin/rector process --dry-run"
    ],
    "rector-fix": [
      "echo \"🔄 Running Rector fixes...\"",
      "vendor/bin/rector process"
    ],
    "security-audit": [
      "echo \"🔒 Running Composer security audit...\"",
      "composer audit --format=summary"
    ],
    "shell-self-tests": [
      "echo '🧪 Running shell script self-tests...'",
      "bash scripts/run-shell-self-tests.sh skills/_shared/assert-current-repo.sh skills/_shared/scan-attachments.sh skills/_shared/read-manifest.sh skills/_shared/classify-risk.sh skills/_shared/run-validation.sh skills/_shared/run-gate.sh skills/_shared/verify-gate.sh skills/_shared/plan-route.sh skills/_shared/check-handoff.sh skills/_shared/gate-context.sh skills/_shared/render-report.sh skills/_shared/record-metrics.sh skills/_shared/browser-drive.sh skills/page-redesign/scripts/render-previews.sh skills/github-issue-triage/scripts/assign-priorities.sh skills/github-issue-triage/scripts/collect-sweep-evidence.sh skills/code-review-bugsnag/scripts/load-issue.sh skills/code-review-jira/scripts/load-issue.sh"
    ],
    "shellcheck": [
      "echo \"🐚 Running ShellCheck...\"",
      "if ! command -v shellcheck > /dev/null 2>&1; then echo '⏭️  shellcheck is not installed locally — skipped here; the CI step enforces it.'; exit 0; fi; git ls-files -z '*.sh' | xargs -0 shellcheck -x -P SCRIPTDIR"
    ],
    "skill-check": [
      "echo \"📋 Running skill-check (SKILL.md linter)...\"",
      "npx skill-check check skills --no-security-scan --format github"
    ],
    "skill-check-fix": [
      "echo \"📋 Running skill-check auto-fix...\"",
      "npx skill-check check skills --fix --no-security-scan --format github"
    ],
    "test:coverage": [
      "echo \"📊 Running coverage tests with PCOV...\"",
      "php -d pcov.enabled=1 -d pcov.directory=src -d pcov.exclude=~tests~ -d xdebug.mode=off vendor/bin/pest --compact --colors=never --coverage tests --min=100"
    ]
  }
}
